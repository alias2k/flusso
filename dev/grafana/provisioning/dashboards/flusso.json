{
  "title": "flusso",
  "uid": "flusso",
  "tags": ["flusso"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Change throughput",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(flusso_changes_captured_total[1m])",
          "legendFormat": "captured/s",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(flusso_changes_committed_total[1m])",
          "legendFormat": "committed/s",
          "refId": "B"
        }
      ]
    },
    {
      "id": 2,
      "title": "In-flight changes (back-pressure)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "flusso_changes_in_flight",
          "legendFormat": "in flight",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Replication slot lag",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "flusso_replication_slot_lag_bytes",
          "legendFormat": "lag",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Flush duration (p95)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(flusso_flush_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Errors",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "flusso_errors_total",
          "legendFormat": "errors",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Documents built",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (index) (rate(flusso_documents_built_total[1m]))",
          "legendFormat": "{{index}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Backlog drain ETA",
      "description": "Estimated time until the replication backlog is fully processed, at the current net drain rate. Shows 'not draining' when the backlog is flat or growing (no finite ETA).",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "not draining (flat or growing)",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 300 },
              { "color": "red", "value": 1800 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "flusso:backlog_drain_eta_seconds",
          "legendFormat": "ETA",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Slot-lag trend (bytes/s; < 0 = draining)",
      "description": "Net rate of change of the slot lag. Negative means catching up, positive means falling behind, ~0 means keeping up in real time.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "flusso:slot_lag_bytes_rate5m",
          "legendFormat": "lag change/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Script failures",
      "description": "Documents a script failed on, by index and field. Under on_error = skip each one keeps its previously indexed version; anything above zero means documents are going stale. Debug with `flusso script run`.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "red" } }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (index, field) (increase(flusso_script_failures_total[5m]))",
          "legendFormat": "{{index}} · {{field}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Visibility wait (s; a commit not visible yet holds every later change)",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "flusso_replication_visibility_wait_seconds",
          "legendFormat": "visibility wait",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 11,
      "title": "Ingest: busy seconds per second, by stage (stacked; the mean number in flight, may pass 1 once stages run concurrently)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 40
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (stage, work) (rate(flusso_stage_duration_seconds_sum{sink=\"\", stage!=\"lane_wait\"}[1m]))",
          "legendFormat": "{{stage}} {{work}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "Sinks: busy seconds per second, by sink and stage (stacked; the mean number in flight, may pass 1 per sink once writes run concurrently)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 40
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (sink, stage) (rate(flusso_stage_duration_seconds_sum{stage=~\"idle|write|seed|reindex\", sink!=\"\"}[1m]))",
          "legendFormat": "{{sink}} {{stage}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "Time per batch, by stage (mean)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (stage, work) (rate(flusso_stage_duration_seconds_sum{stage!=\"idle\"}[5m])) / sum by (stage, work) (rate(flusso_stage_duration_seconds_count{stage!=\"idle\"}[5m]))",
          "legendFormat": "{{stage}} {{work}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "title": "Flush size (mean per flush)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (sink, work) (rate(flusso_flush_documents_sum[5m])) / sum by (sink, work) (rate(flusso_flush_documents_count[5m]))",
          "legendFormat": "{{sink}} {{work}} documents",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (sink, work) (rate(flusso_flush_size_bytes_sum[5m])) / sum by (sink, work) (rate(flusso_flush_size_bytes_count[5m])) / 1024",
          "legendFormat": "{{sink}} {{work}} KiB",
          "refId": "B"
        }
      ]
    },
    {
      "id": 15,
      "title": "Built documents held (bytes; the budget is [concurrency] max_built_mib)",
      "description": "Heap of built documents not yet acknowledged by every sink, by work. Backfill holds at most half of the budget. A flat line at the budget means a sink isn't acknowledging and ingest is paced; the waits are batches that waited for room.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 52 },
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "custom.axisPlacement", "value": "right" }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (work) (flusso_memory_built_bytes)",
          "legendFormat": "{{work}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (work) (rate(flusso_memory_refused_total[5m]))",
          "legendFormat": "{{work}} waits/s",
          "refId": "B"
        }
      ]
    },
    {
      "id": 16,
      "title": "Lane stall age (s; a lane that writes nothing pins the slot for every index)",
      "description": "How long each (index, sink) lane's oldest outstanding change has stayed its oldest. 0 while the lane writes. FlussoLaneStalled fires past 10 minutes.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 52 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 600 } ] }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (index, sink) (flusso_lane_stall_age_seconds)",
          "legendFormat": "{{index}} → {{sink}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 17,
      "title": "WAL held per lane (bytes; the pinning lane holds the slot's whole lag)",
      "description": "Bytes of WAL the replication slot keeps because of each lane, while it has a change outstanding. The lane marked pinned holds the slot back the most. When an index's backlog (documents waiting or building, on no lane yet) holds it instead, that index is marked with the slot's whole lag.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 60 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (index, sink) (flusso_lane_wal_behind_bytes)",
          "legendFormat": "{{index}} → {{sink}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (index, sink) (flusso_lane_wal_behind_bytes * on (index, sink) flusso_slot_pinned_by)",
          "legendFormat": "pinned by {{index}} → {{sink}}",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (index) (flusso_slot_pinned_by{sink=\"\"} * on () group_left max(flusso_replication_slot_lag_bytes))",
          "legendFormat": "pinned by {{index}}'s backlog (no lane yet)",
          "refId": "C"
        }
      ]
    },
    {
      "id": 18,
      "title": "Index backlog age (s; how long ago an index's oldest unbuilt change was read)",
      "description": "Per index: how long ago its oldest change not built yet (waiting, or in a build not sent to a lane) was read. Grows only while the index is exempt or stuck, and falls as it catches up. Reading stops at an index's cap, so an index that paces the reader stays within its read-ahead (seconds), at its sink's limit and however far it falls behind its source: that lag is its lanes' WAL behind (the WAL held per lane panel) and the slot lag. 0 while no engine run reads.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 68 },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (index) (flusso_index_backlog_age_seconds)",
          "legendFormat": "{{index}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 19,
      "title": "Indexes exempt, frozen, held or not working (1 = yes)",
      "description": "Per index: exempt (held at its cap while the others read on), frozen (exempt, may drain but not grow), held by the memory budget or a full lane, not working (a sink has acknowledged nothing of it for 5 s; held is not enough). FlussoIndexBacklog fires once exempt, or stuck (backlog age over a minute), for 10 minutes; also during a planned catch-up longer than that when one index is slower than the others.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 68 },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (index) (flusso_index_exempt)",
          "legendFormat": "{{index}} exempt",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (index) (flusso_index_frozen)",
          "legendFormat": "{{index}} frozen",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (index, by) (flusso_index_held) > 0",
          "legendFormat": "{{index}} held by {{by}}",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "1 - max by (index) (flusso_index_working)",
          "legendFormat": "{{index}} not working",
          "refId": "D"
        }
      ]
    },
    {
      "id": 20,
      "title": "Reader waits at its lead, by bound (waits per second; seconds waiting per second)",
      "description": "How often the reader stops at its lead and for how long, by the bound that stopped it: per_index (an index at its cap, labelled with the index), total (the non-exempt indexes' documents), changes (changes read ahead), pending (the exempt indexes at max_pending_documents).",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 76 },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (bound) (rate(flusso_reader_waits_seconds_count[5m]))",
          "legendFormat": "{{bound}} waits/s",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (bound) (rate(flusso_reader_waits_seconds_sum[5m]))",
          "legendFormat": "{{bound}} s/s",
          "refId": "B"
        }
      ]
    }
  ]
}
